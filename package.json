{
  "name": "meowpiano",
  "type": "module",
  "scripts": {
    "test": "vitest run tests/",
    "test:e2e": "playwright test",
    "screenshot": "UPDATE_PREVIEW=1 playwright test e2e/smoke.spec.js --project=desktop",
    "test:all": "npm test && npm run test:e2e",
    "help-clips": "node tools/help-clips.js",
    "vendor": "curl -fsSL https://raw.githubusercontent.com/csciuto/midi-in/v$(node -p \"require('./package.json').vendored['midi-in']\")/midi-in.js -o js/vendor/midi-in.js",
    "help-clips:phone": "node tools/help-clips.js --phone"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "^1.64.1",
    "sharp": "^0.34.3",
    "vitest": "^2.0.0"
  },
  "vendored": {
    "midi-in": "1.0.0"
  }
}
